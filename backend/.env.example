# Backend (Firestore-backed)

# Firebase service account: download from
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# Save as backend/serviceAccount.json (or set this to the path you used).
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccount.json
# Firebase console -> Project settings -> General -> Project ID
FIREBASE_PROJECT_ID=

# Code runner limits
RUNNER_TIMEOUT_SECONDS=5
RUNNER_MEMORY_MB=128
# Maximum characters of code to accept
MAX_CODE_LENGTH=20000
